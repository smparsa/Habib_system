# متغیرهای محیطی نمونه — این فایل را به .env کپی و مقادیر را پر کنید.
# فایل .env محلی است و در git نادیده گرفته می‌شود (هرگز کلید واقعی را اینجا نگذارید).

# ---------- Archil (دیسک پایدار) ----------
# کلید API از https://console.archil.com/api-keys — با پیشوند key- (توکن دیسک/مانت adt_… نیست).
ARCHIL_API_KEY=
# ناحیهٔ کلید؛ exec فقط در aws-us-east-1، aws-us-west-2 و aws-eu-west-1 اجرا می‌شود.
ARCHIL_REGION=aws-us-east-1
# شناسهٔ دیسک (dsk-…) — با اولین اجرای check_archil_persistence.py پر می‌شود.
ARCHIL_DISK_ID=
